# Optional. Copy to instance.env to give this copy of the skill a built-in server URL.
# The API key never goes in this file: pass it as SHARED_MEMORY_API_KEY the first time you run scripts/install.py.
SHARED_MEMORY_URL=https://YOUR_DEPLOYMENT_URL/mcp

# Optional: the URL this copy used before. When you move the server, set SHARED_MEMORY_URL above to the new
# address and list the old one here; `git pull && python3 scripts/install.py` then updates a machine that
# already installed it (the saved ~/.config/shared-memory/env and Codex's config.toml).
# SHARED_MEMORY_OLD_URL=https://old-host.example/mcp
