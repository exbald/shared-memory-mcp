# Required when you run the server yourself: Postgres with the pgvector extension available.
# The server creates (or upgrades) its `memories` table on boot.
# Not needed with docker-compose.yml, which points the server at its own database.
DATABASE_URL=postgres://memory:CHANGE_ME@localhost:5432/memory

# docker-compose.yml only: the password of its bundled Postgres.
# Use letters and digits: it becomes part of a connection URL.
POSTGRES_PASSWORD=

# Required: the shared secret for /mcp. Make one with `openssl rand -hex 32`
# (hex, so it is also safe in a `?key=` URL). Clients send it as `X-API-Key:`,
# `Authorization: Bearer ...` or `?key=...`. Treat it as a secret.
# The server refuses to start without it unless MCP_ALLOW_NO_AUTH=1 (open to anyone who can reach it).
MCP_API_KEY=

# Optional: enables meaning-based search, so a paraphrase finds a memory with no shared words.
# Model `text-embedding-3-small`: an OpenRouter key (sk-or-...) goes through OpenRouter,
# any other key (an OpenAI key) is sent to OpenAI directly. Same vectors either way.
# Without it, search matches keywords only.
EMBEDDING_API_KEY=

# Optional tuning. Defaults: PORT=3000, PG_POOL_MAX=5,
# SEARCH_MIN_SIMILARITY=0.30 (cosine floor for the meaning half of search),
# DEDUP_SIMILARITY=0.82 (mem_add lists existing memories at least this similar).
# PORT=3000
# PG_POOL_MAX=5
# SEARCH_MIN_SIMILARITY=0.30
# DEDUP_SIMILARITY=0.82
