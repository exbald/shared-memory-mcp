# Required: Supabase project that holds the `memories` table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: gate the /mcp endpoint with a shared secret.
# Clients pass it via `?key=...`, `X-API-Key:`, or `Authorization: Bearer ...`.
# If unset, the endpoint is unauthenticated. Treat this value as a secret.
MCP_API_KEY=

# Optional: enables hybrid (vector + keyword) search in mem_search.
# When set, mem_add embeds new content and mem_search re-ranks by cosine similarity.
# Uses OpenRouter's embeddings endpoint with model `openai/text-embedding-3-small`.
EMBEDDING_API_KEY=
